<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/black">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingHorizontal="24dp"
        android:paddingTop="16dp"
        android:paddingBottom="24dp">

        <ImageView
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:src="@drawable/glossy_obg_logo"
            android:contentDescription="App Logo"
            android:layout_marginBottom="6dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Select Language"
            android:textColor="@color/white"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Seleccione el Idioma  ·  Choix de la langue\n言語を選択  ·  언어 선택  ·  选择语言"
            android:textColor="@color/accent_blue"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginBottom="24dp" />

        <!-- English -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEnglish"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="English"
            android:textSize="16sp"
            android:textStyle="bold"
            android:padding="14dp"
            app:backgroundTint="@color/primary_blue"
            android:textColor="@color/white"
            app:cornerRadius="0dp"
            app:strokeColor="@color/darker_gray"
            app:strokeWidth="5dp" />

        <!-- Español -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSpanish"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="Español"
            android:textSize="16sp"
            android:textStyle="bold"
            android:padding="14dp"
            app:backgroundTint="@color/light_green"
            android:textColor="@color/white"
            app:cornerRadius="0dp"
            app:strokeColor="@color/darker_gray"
            app:strokeWidth="5dp" />

        <!-- Français -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFrench"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="Français"
            android:textSize="16sp"
            android:textStyle="bold"
            android:padding="14dp"
            app:backgroundTint="@color/primary_blue"
            android:textColor="@color/white"
            app:cornerRadius="0dp"
            app:strokeColor="@color/darker_gray"
            app:strokeWidth="5dp" />

        <!-- 日本語 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnJapanese"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="日本語"
            android:textSize="16sp"
            android:textStyle="bold"
            android:padding="14dp"
            app:backgroundTint="@color/light_green"
            android:textColor="@color/white"
            app:cornerRadius="0dp"
            app:strokeColor="@color/darker_gray"
            app:strokeWidth="5dp" />

        <!-- 한국어 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnKorean"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="한국어"
            android:textSize="16sp"
            android:textStyle="bold"
            android:padding="14dp"
            app:backgroundTint="@color/primary_blue"
            android:textColor="@color/white"
            app:cornerRadius="0dp"
            app:strokeColor="@color/darker_gray"
            app:strokeWidth="5dp" />

        <!-- 中文 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnChinese"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="中文"
            android:textSize="16sp"
            android:textStyle="bold"
            android:padding="14dp"
            app:backgroundTint="@color/light_green"
            android:textColor="@color/white"
            app:cornerRadius="0dp"
            app:strokeColor="@color/darker_gray"
            app:strokeWidth="5dp" />

    </LinearLayout>
</ScrollView>
