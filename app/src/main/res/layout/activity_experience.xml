<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light">

    <!-- Background Shapes -->
    <ImageView
        android:layout_width="300dp"
        android:layout_height="300dp"
        android:layout_gravity="top|start"
        android:layout_marginTop="-100dp"
        android:layout_marginStart="-100dp"
        android:src="@drawable/bg_shape_top"
        android:rotation="180" />

    <ImageView
        android:layout_width="300dp"
        android:layout_height="300dp"
        android:layout_gravity="bottom|end"
        android:layout_marginBottom="-100dp"
        android:layout_marginEnd="-100dp"
        android:src="@drawable/bg_shape_bottom"
        android:rotation="180" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Surfing Experience"
            android:textColor="@color/primary_dark_blue"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="On a scale of 1 to 10, how experienced are you?"
            android:textColor="@color/text_dark"
            android:textSize="16sp"
            android:gravity="center"
            android:layout_marginBottom="40dp" />

        <SeekBar
            android:id="@+id/seekBarExperience"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="9"
            android:progress="0"
            android:progressTint="@color/primary_blue"
            android:thumbTint="@color/primary_dark_blue"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/tvExperienceValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Level: 1 (Tourist)"
            android:textColor="@color/primary_green"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="48dp" />

        <Button
            android:id="@+id/btnContinue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Continue"
            android:backgroundTint="@color/primary_blue" />

    </LinearLayout>
</FrameLayout>
